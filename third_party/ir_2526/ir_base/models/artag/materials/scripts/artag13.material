// AprilTag marker material, OGRE script.
// Tag image rendered from the AprilTag tag36h11 family definition
// (AprilRobotics/apriltag, BSD-2-Clause).
material material/artag13
{
  technique
  {
    pass
    {
      ambient 1.0 1.0 1.0 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.0 0.0 0.0 1.0 12.5
      texture_unit
      {
        texture tag36_11_00013.png
        filtering anisotropic
        max_anisotropy 16
        scale 1 1
      }
    }
  }
}
