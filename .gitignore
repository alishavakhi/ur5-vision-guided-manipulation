*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments.
# A full virtualenv (numpy/scipy binaries) was accidentally committed to the
# original repository and bloated its history to ~50 MB. It is ignored here and
# is not present in this repository's history.
venv/
venv*/
.venv/
env/
ENV/
env.bak/
venv.bak/

