<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>group29_assignment_2</name>
  <version>0.0.0</version>
  <description>
    Vision-guided UR5 cube swapping. AprilTag pose estimation, HSV ring-band
    colour classification, pose/colour fusion, and a MoveIt 2 pick-and-place
    sequence driven through a control_msgs GripperCommand action.
  </description>

  <maintainer email="45035448+alishavakhi@users.noreply.github.com">Ali Shavakhi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ node (manipulation_node) -->
  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- moveit_msgs: CollisionObject / Constraints in manipulation_node.cpp -->
  <depend>moveit_msgs</depend>
  <!-- shape_msgs: SolidPrimitive for the cube collision boxes -->
  <depend>shape_msgs</depend>

  <!-- Python nodes (tag_detector / color_detector / cube_fusion) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- dt_apriltags is a pip package, not a rosdep key: pip install dt-apriltags -->
  <exec_depend>python3-dt-apriltags</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
